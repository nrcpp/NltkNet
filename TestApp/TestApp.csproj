<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <Import Project="../eng/host-runtime.props" />
  <ItemGroup>
    <ProjectReference Include="../NltkNet.Runtime.$(NltkNetRuntimeRid)/NltkNet.Runtime.$(NltkNetRuntimeRid).csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NltkNet\NltkNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../.artifacts/nltk-data/**/*" Link="nltknet/data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../NltkNet.Runtime.$(NltkNetRuntimeRid)/buildTransitive/NltkNet.Runtime.$(NltkNetRuntimeRid).targets" Condition="Exists('../NltkNet.Runtime.$(NltkNetRuntimeRid)/buildTransitive/NltkNet.Runtime.$(NltkNetRuntimeRid).targets')" />
</Project>