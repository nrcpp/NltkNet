<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Denis Kazakov</Authors>
    <PackageProjectUrl>https://github.com/nrcpp/NltkNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nrcpp/NltkNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>nltk;nlp;python;tokenization;pos;ner</PackageTags>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>NltkNet</AssemblyTitle>
    <Description>.NET wrapper for NLTK library written on Python</Description>
    <Company>Denis Kazakov</Company>
    <Product>NltkNet</Product>
    <Copyright>Copyright ©  2019</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.2.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../assets/nuget-icon.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
</Project>